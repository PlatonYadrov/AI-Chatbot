LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL_NAME=t-tech/T-pro-it-2.0-AWQ
LLM_MODEL=t-tech/T-pro-it-2.0-AWQ
LLM_API_KEY=dummy

EMBEDDINGS_BASE_URL=http://embeddings:80
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
OCR_URL=http://ocr:9000/ocr
DATA_DIR=/data
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_chunks

# PostgreSQL for chat session storage (asyncpg for async operations)
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@postgres:5432/rag_chatbot

# Docling local configuration (all models run locally)
DOCLING_OFFLINE_MODE=true
DOCLING_OCR_ENABLED=true
DOCLING_EXTRACT_TABLES=true
DOCLING_CACHE_DIR=/app/.cache/huggingface
DOCLING_USE_VLM=false  # VLM disabled to save VRAM for vLLM (2x L4 24GB)

# Docling Chunking Configuration (structure-aware chunking)
# Set USE_DOCLING_CHUNKING=true for better RAG quality (+30% context preservation)
USE_DOCLING_CHUNKING=true  # false = traditional chunking, true = HybridChunker
CHUNKING_MAX_TOKENS=450      # Max tokens per chunk (stay under 512 limit)
CHUNKING_OVERLAP=100         # Token overlap between chunks
# CHUNKING_TOKENIZER=intfloat/multilingual-e5-large  # Auto-detected from EMBEDDINGS_MODEL if not set

# Reranking Configuration (Infinity container-based, no torch in Python!)
# Model runs in separate Infinity container - change in docker-compose.yml
# Available models:
#   - BAAI/bge-reranker-v2-m3          (Multilingual, recommended, best quality/speed balance)
#   - BAAI/bge-reranker-large          (Higher quality, slower)
#   - BAAI/bge-reranker-base           (Faster, good quality)
#   - mixedbread-ai/mxbai-rerank-large-v1  (Top quality, slower)
#   - cross-encoder/ms-marco-mMiniLM-L-12-v2  (Classic MS MARCO)
RERANKER_URL=http://reranker:8081  # Custom reranker service URL
RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # For logging/metadata
RERANKER_TIMEOUT=30  # Request timeout in seconds
RERANKER_PREFER_INFINITY=true  # Prefer Infinity over local torch reranker

# Reranker service configuration (custom container)
RERANKER_DEVICE=cuda  # Device for reranker container
PORT=8081  # Port for reranker service

# Legacy settings (not used with custom reranker service)
CROSS_ENCODER_DEVICE=auto
CROSS_ENCODER_BATCH_SIZE=32
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_CACHE_DIR=/app/.cache/huggingface
